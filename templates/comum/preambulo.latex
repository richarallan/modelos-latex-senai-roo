% Preâmbulo compartilhado pelos perfis acadêmicos institucionais.
\PassOptionsToPackage{unicode}{hyperref}
\PassOptionsToPackage{hyphens}{url}
\documentclass[$if(classoption)$$for(classoption)$$classoption$$sep$,$endfor$$else$artigo$endif$]{$if(documentclass)$$documentclass$$else$senaiarticle$endif$}
\usepackage{amsmath,amssymb}
\usepackage{unicode-math}
\usepackage[bidi=default]{babel}
\babelprovide[main,import]{$if(babel-lang)$$babel-lang$$else$brazilian$endif$}
\usepackage{bookmark}
\IfFileExists{xurl.sty}{\usepackage{xurl}}{}
\IfFileExists{upquote.sty}{\usepackage{upquote}}{}
\urlstyle{same}
\setlength{\emergencystretch}{3em}
\providecommand{\tightlist}{%
  \setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}
$if(highlighting-macros)$
$highlighting-macros$
$endif$
$if(verbatim-in-note)$
\usepackage{fancyvrb}
\VerbatimFootnotes
$endif$
$if(tables)$
\usepackage{array,calc}
$if(multirow)$
\usepackage{multirow}
$endif$
\usepackage{etoolbox}
\makeatletter
\patchcmd\longtable{\par}{\if@noskipsec\mbox{}\fi\par}{}{}
\makeatother
\IfFileExists{footnotehyper.sty}{\usepackage{footnotehyper}}{\usepackage{footnote}}
\makesavenoteenv{longtable}
$endif$
% Restringe figuras às margens sem impedir dimensões explícitas no Markdown.
\makeatletter
\def\maxwidth{\ifdim\Gin@nat@width>\linewidth\linewidth\else\Gin@nat@width\fi}
\def\maxheight{\ifdim\Gin@nat@height>\textheight\textheight\else\Gin@nat@height\fi}
\def\fps@figure{htbp}
\makeatother
\setkeys{Gin}{width=\maxwidth,height=\maxheight,keepaspectratio}
$if(strikeout)$
% Pandoc 2.17 usa \sout; versões recentes usam \st.
\usepackage[normalem]{ulem}
\providecommand{\st}[1]{\sout{#1}}
\providecommand{\ul}[1]{\uline{#1}}
\pdfstringdefDisableCommands{\renewcommand{\sout}{}}
$endif$
$if(numbersections)$
\setcounter{secnumdepth}{3}
$else$
\setcounter{secnumdepth}{-1}
$endif$
$if(csl-refs)$
% Compatibilidade com as referências produzidas pelo citeproc do Pandoc.
\NewDocumentCommand\citeproctext{}{}
\NewDocumentCommand\citeproc{mm}{%
  \begingroup\def\citeproctext{#2}\cite{#1}\endgroup}
\makeatletter
\let\@cite@ofmt\@firstofone
\def\@biblabel#1{}
\def\@cite#1#2{{#1\if@tempswa , #2\fi}}
\makeatother
\newlength{\cslhangindent}
\setlength{\cslhangindent}{1.5em}
\newlength{\csllabelwidth}
\setlength{\csllabelwidth}{3em}
$if(senai-csl-legado)$
% Compatibilidade com writers em parágrafos, incluindo Pandoc 2.17 e 3.1.3.
\newenvironment{CSLReferences}[2]
 {\begingroup\setstretch{1}\setlength{\parindent}{0pt}%
  \ifodd #1\everypar{\hangindent=\cslhangindent}\fi
  \setlength{\parskip}{#2\baselineskip}}
 {\par\endgroup}
$else$
\newenvironment{CSLReferences}[2]
 {\begingroup\setstretch{1}\begin{list}{}{%
  \setlength{\itemindent}{0pt}\setlength{\leftmargin}{0pt}\setlength{\parsep}{0pt}
  \ifodd #1
    \setlength{\leftmargin}{\cslhangindent}\setlength{\itemindent}{-1\cslhangindent}
  \fi
  \setlength{\itemsep}{#2\baselineskip}}}
 {\end{list}\endgroup}
$endif$
\usepackage{calc}
\newcommand{\CSLBlock}[1]{\hfill\break\parbox[t]{\linewidth}{\strut\ignorespaces#1\strut}}
\newcommand{\CSLLeftMargin}[1]{\parbox[t]{\csllabelwidth}{\strut#1\strut}}
\newcommand{\CSLRightInline}[1]{\parbox[t]{\linewidth - \csllabelwidth}{\strut#1\strut}}
\newcommand{\CSLIndent}[1]{\hspace{\cslhangindent}#1}
$endif$
\hypersetup{
  pdftitle={$if(title-meta)$$title-meta$$else$$title$$endif$},
  pdfauthor={$if(author-meta)$$author-meta$$endif$},
  pdflang={$if(lang)$$lang$$else$pt-BR$endif$},
$if(palavras_chave)$
  pdfkeywords={$for(palavras_chave)$$palavras_chave$$sep$, $endfor$},
$endif$
  pdfcreator={LaTeX via Pandoc},
  hidelinks
}
$for(header-includes)$
$header-includes$
$endfor$
% O logo é fornecido pelo renderizador, nunca reconstruído tipograficamente.
\newcommand{\senaimarca}{%
$if(logo-institucional)$
  \noindent\makebox[\textwidth][c]{\includegraphics[width=\paperwidth]{$logo-institucional$}}\par
$else$
$if(logo-artigo)$
  \noindent\makebox[\textwidth][c]{\includegraphics[width=\paperwidth]{$logo-artigo$}}\par
$endif$
$endif$
}
\newcommand{\senaiassinatura}[1]{%
  \par\vspace{0.65cm}\noindent\rule{0.65\textwidth}{0.4pt}\par
  {\small #1\par}}
