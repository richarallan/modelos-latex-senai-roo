$../comum/preambulo()$

\begin{document}
$for(include-before)$
$include-before$
$endfor$
$if(pre-textuais)$
\hypersetup{pageanchor=false}
$if(mostrar-capa)$
% Capa: hierarquia e alinhamentos do modelo institucional.
\begin{titlepage}
\centering
\senaimarca
\vspace{1.3cm}
{\bfseries TRABALHO DE CONCLUSÃO DE CURSO\par}
\vspace{0.85cm}
{\bfseries ARTIGO CIENTÍFICO\par}
\vspace{0.85cm}
{\bfseries\MakeUppercase{$curso$}\par}
\vspace{1.05cm}
% Mantém título e subtítulo juntos, inclusive quando ocupam várias linhas.
\begin{minipage}{0.94\textwidth}
\centering
{\bfseries\MakeUppercase{$title$}\par}
$if(subtitle)$
\vspace{0.3cm}
{$subtitle$\par}
$endif$
\end{minipage}\par
\vspace{2.4cm}
% A autoria forma um bloco único, alinhado à direita como no modelo original.
\begin{minipage}{\textwidth}
\raggedleft
\bfseries
$for(author)$
$author$\par
$endfor$
\end{minipage}\par
\vfill
$if(local)$
{\bfseries\MakeUppercase{$local$}\par}
$endif$
$if(date)$
{\bfseries $date$\par}
$endif$
% Respiro inferior constante, mesmo sem cidade ou data.
\vspace*{1.8cm}
\end{titlepage}
$endif$
$if(mostrar-folha-rosto)$
% Folha de rosto: natureza do trabalho no bloco direito.
\begin{titlepage}
\centering
\senaimarca
\vspace{0.4cm}
{\bfseries
$for(author)$
$author$\par
$endfor$
}
% Centralização vertical do conjunto título, natureza do trabalho e orientação.
\vspace{4.5cm}
{\bfseries\MakeUppercase{$title$}\par}
$if(subtitle)$
\vspace{0.3cm}
{$subtitle$\par}
$endif$
\vspace{0.8cm}
\begin{flushright}
\begin{minipage}{0.5\textwidth}
\setlength{\parindent}{0pt}
Artigo científico apresentado no curso de $curso$, como exigência para obtenção do título de Técnico em $habilitacao$.
$if(orientador)$
\par\vspace{0.6cm}
\textbf{Orientador(a):} $orientador$
$endif$
\end{minipage}
\end{flushright}
\vfill
$if(local)$
{\bfseries\MakeUppercase{$local$}\par}
$endif$
$if(date)$
{\bfseries $date$\par}
$endif$
\end{titlepage}
$endif$
$../comum/aprovacao()$

\hypersetup{pageanchor=true}
$endif$
% Corpo do artigo: paginação independente dos elementos pré-textuais.
\pagenumbering{arabic}
\pagestyle{senaiartigo}
