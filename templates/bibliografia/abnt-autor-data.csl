<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0"
       demote-non-dropping-particle="display-and-sort" default-locale="pt-BR">

  <info>
    <title>ABNT NBR 6023:2025 e NBR 10520:2023 (autor-data)</title>
    <id>https://raw.githubusercontent.com/icaro1053/csl-abnt/main/abnt-ufu-6023-2025.csl</id>
    <link href="https://raw.githubusercontent.com/icaro1053/csl-abnt/main/abnt-ufu-6023-2025.csl" rel="self"/>
    <author><name>Ícaro Gonçalves Pereira</name></author>
    <category citation-format="author-date"/>
    <category field="generic-base"/>
    <summary>Autor-data conforme a ABNT NBR 6023:2025 (referências) e a ABNT NBR
      10520:2023 (citações). Sobrenome em caixa alta na lista e em caixa mista nas
      citações; todos os autores na referência; et al. em itálico a partir de quatro na citação.</summary>
    <updated>2026-11-08T09:00:00-03:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">CC BY-SA 3.0</rights>
  </info>

  <locale xml:lang="pt-BR">
    <terms>
      <term name="month-01" form="short">jan.</term>
      <term name="month-02" form="short">fev.</term>
      <term name="month-03" form="short">mar.</term>
      <term name="month-04" form="short">abr.</term>
      <term name="month-05" form="short">maio</term>
      <term name="month-06" form="short">jun.</term>
      <term name="month-07" form="short">jul.</term>
      <term name="month-08" form="short">ago.</term>
      <term name="month-09" form="short">set.</term>
      <term name="month-10" form="short">out.</term>
      <term name="month-11" form="short">nov.</term>
      <term name="month-12" form="short">dez.</term>
      <term name="et-al">et al.</term>
      <term name="page" form="short">p.</term>
      <term name="volume" form="short">v.</term>
      <term name="issue" form="short">n.</term>
      <term name="edition" form="short">ed.</term>
      <term name="no date">[s. d.]</term>
      <term name="accessed">Acesso em</term>
      <term name="available at">Disponível em</term>
      <term name="in">In</term>
      <term name="page-range-delimiter">-</term>
    </terms>
  </locale>

  <!-- ─────────────── AUTORIA ─────────────── -->

  <!-- lista de referências: sobrenome em caixa alta, TODOS os autores (8.1.1.2) -->
  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=", " delimiter="; "
            delimiter-precedes-last="always">
        <name-part name="family" text-case="uppercase"/>
      </name>
      <label form="short" prefix=" (" suffix=")"/>
      <substitute>
        <names variable="editor"/>
        <names variable="director"/>
        <text macro="title-destaque-sem-autor"/>
      </substitute>
    </names>
  </macro>

  <!-- citação no texto: caixa mista (10520 6.1.1.1), et al. em itálico a partir de 4 (10520 6.1.2) -->
  <macro name="author-citation">
    <names variable="author">
      <name form="short" delimiter="; " delimiter-precedes-last="always"
            et-al-min="4" et-al-use-first="1"/>
      <et-al font-style="italic"/>
      <substitute>
        <names variable="editor"/>
        <names variable="director"/>
        <text macro="title-citation"/>
      </substitute>
    </names>
  </macro>

  <!-- responsabilidade da obra que contém a parte (6023 7.3) -->
  <macro name="responsavel-container">
    <names variable="container-author" suffix=".">
      <name name-as-sort-order="all" sort-separator=", " delimiter="; "
            delimiter-precedes-last="always">
        <name-part name="family" text-case="uppercase"/>
      </name>
      <substitute>
        <names variable="editor">
          <name name-as-sort-order="all" sort-separator=", " delimiter="; "
                delimiter-precedes-last="always">
            <name-part name="family" text-case="uppercase"/>
          </name>
          <label form="short" prefix=" (" suffix=")"/>
        </names>
      </substitute>
    </names>
  </macro>

  <macro name="editor-secundario">
    <names variable="editor translator" delimiter=". ">
      <label form="verb" text-case="capitalize-first" suffix=" "/>
      <name delimiter="; " delimiter-precedes-last="always"/>
    </names>
  </macro>

  <!-- ─────────────── TÍTULOS ─────────────── -->

  <!-- obra no todo: destaque tipográfico (6023 8.3) -->
  <macro name="title-destaque">
    <group delimiter=": ">
      <text variable="title" font-weight="bold"/>
    </group>
  </macro>

  <!-- obra sem autoria: primeira palavra em caixa alta (10520 6.1.1.4) -->
  <macro name="title-destaque-sem-autor">
    <text variable="title" font-weight="bold"/>
  </macro>

  <!-- parte de obra (artigo, capítulo): sem destaque -->
  <macro name="title-simples">
    <text variable="title"/>
  </macro>

  <!-- título como entrada de citação, quando não há autor -->
  <macro name="title-citation">
    <text variable="title" form="short"/>
  </macro>

  <!-- periódico ou obra que contém a parte: recebe o destaque -->
  <macro name="container">
    <text variable="container-title" font-weight="bold"/>
  </macro>

  <!-- ─────────────── IMPRENTA ─────────────── -->

  <macro name="edicao">
    <choose>
      <if is-numeric="edition">
        <group delimiter=" ">
          <number variable="edition" form="numeric" suffix="."/>
          <text term="edition" form="short"/>
        </group>
      </if>
      <else>
        <text variable="edition"/>
      </else>
    </choose>
  </macro>

  <macro name="local">
    <choose>
      <if variable="publisher-place">
        <text variable="publisher-place"/>
      </if>
      <else><text value="[S. l.]"/></else>
    </choose>
  </macro>

  <macro name="editora">
    <choose>
      <if variable="publisher">
        <text variable="publisher"/>
      </if>
      <else><text value="[s. n.]"/></else>
    </choose>
  </macro>

  <macro name="imprenta">
    <group delimiter=", ">
      <group delimiter=": ">
        <text macro="local"/>
        <text macro="editora"/>
      </group>
      <text macro="ano"/>
    </group>
  </macro>

  <macro name="ano">
    <choose>
      <if variable="issued">
        <date variable="issued"><date-part name="year"/></date>
      </if>
      <else><text term="no date"/></else>
    </choose>
  </macro>

  <!-- periódico: mês abreviado + ano -->
  <macro name="data-periodico">
    <choose>
      <if variable="issued">
        <date variable="issued" delimiter=" ">
          <date-part name="month" form="short"/>
          <date-part name="year"/>
        </date>
      </if>
      <else><text term="no date"/></else>
    </choose>
  </macro>

  <macro name="volume">
    <group delimiter=" ">
      <text term="volume" form="short"/>
      <text variable="volume"/>
    </group>
  </macro>

  <macro name="numero">
    <group delimiter=" ">
      <text term="issue" form="short"/>
      <text variable="issue"/>
    </group>
  </macro>

  <macro name="paginas">
    <group delimiter=" ">
      <text term="page" form="short"/>
      <text variable="page"/>
    </group>
  </macro>

  <!-- ─────────────── MEIO ELETRÔNICO (6023 6.6) ─────────────── -->

  <macro name="doi">
    <choose>
      <if variable="DOI">
        <text variable="DOI" prefix="DOI: https://doi.org/" suffix="."/>
      </if>
    </choose>
  </macro>

  <macro name="disponivel">
    <choose>
      <if variable="URL">
        <text variable="URL" prefix="Disponível em: " suffix="."/>
      </if>
    </choose>
  </macro>

  <macro name="acesso">
    <choose>
      <if variable="accessed">
        <date variable="accessed" prefix="Acesso em: " suffix="." delimiter=" ">
          <date-part name="day"/>
          <date-part name="month" form="short"/>
          <date-part name="year"/>
        </date>
      </if>
    </choose>
  </macro>

  <macro name="eletronico">
    <group delimiter=" ">
      <text macro="doi"/>
      <text macro="disponivel"/>
      <text macro="acesso"/>
    </group>
  </macro>

  <!-- ─────────────── EVENTO (6023 7.8) ─────────────── -->

  <macro name="evento">
    <group delimiter=", ">
      <text variable="event" text-case="uppercase"/>
      <text variable="number" suffix="."/>
      <date variable="issued"><date-part name="year"/></date>
      <text variable="event-place"/>
    </group>
  </macro>

  <!-- ─────────────── TESE E DISSERTAÇÃO (6023 7.1) ─────────────── -->

  <macro name="tipo-tese">
    <group delimiter=" ">
      <choose>
        <if variable="genre"><text variable="genre"/></if>
        <else><text value="Tese"/></else>
      </choose>
    </group>
  </macro>

  <!-- ═══════════════ CITAÇÃO ═══════════════ -->

  <citation disambiguate-add-year-suffix="true"
            et-al-min="4" et-al-use-first="1">
    <layout prefix="(" suffix=")" delimiter="; ">
      <group delimiter=", ">
        <text macro="author-citation"/>
        <text macro="ano"/>
        <group delimiter=" ">
          <label variable="locator" form="short"/>
          <text variable="locator"/>
        </group>
      </group>
    </layout>
  </citation>

  <!-- ═══════════════ REFERÊNCIAS ═══════════════ -->

  <bibliography hanging-indent="false" entry-spacing="1" line-spacing="1">

    <sort>
      <key macro="author"/>
      <key variable="issued"/>
      <key variable="title"/>
    </sort>

    <layout suffix=".">
      <choose>

        <!-- ARTIGO DE PERIÓDICO (7.7.5 / 7.7.6) -->
        <if type="article-journal article-magazine article-newspaper" match="any">
          <group delimiter=". ">
            <text macro="author"/>
            <text macro="title-simples"/>
            <group delimiter=", ">
              <text macro="container"/>
              <text variable="publisher-place"/>
              <text macro="volume"/>
              <text macro="numero"/>
              <text macro="paginas"/>
              <text macro="data-periodico"/>
            </group>
          </group>
          <text macro="eletronico" prefix=". "/>
        </if>

        <!-- CAPÍTULO OU PARTE DE MONOGRAFIA (7.3 / 7.4) -->
        <else-if type="chapter entry-encyclopedia entry-dictionary" match="any">
          <group delimiter=". ">
            <text macro="author"/>
            <text macro="title-simples"/>
            <group delimiter=" ">
              <text term="in" text-case="capitalize-first" suffix=":"/>
              <text macro="responsavel-container"/>
              <text macro="container"/>
            </group>
            <text macro="edicao"/>
            <text macro="imprenta"/>
            <text macro="paginas"/>
          </group>
          <text macro="eletronico" prefix=". "/>
        </else-if>

        <!-- TRABALHO EM EVENTO (7.8.4) -->
        <else-if type="paper-conference speech" match="any">
          <group delimiter=". ">
            <text macro="author"/>
            <text macro="title-simples"/>
            <group delimiter=" ">
              <text term="in" text-case="capitalize-first" suffix=":"/>
              <text macro="evento"/>
            </group>
            <text value="Anais [...]" font-weight="bold"/>
            <text macro="imprenta"/>
            <text macro="paginas"/>
          </group>
          <text macro="eletronico" prefix=". "/>
        </else-if>

        <!-- TESE E DISSERTAÇÃO (7.1) -->
        <else-if type="thesis">
          <group delimiter=". ">
            <text macro="author"/>
            <text macro="title-destaque"/>
            <text macro="ano"/>
            <text variable="number-of-pages" suffix=" f."/>
            <group delimiter=" – ">
              <text macro="tipo-tese"/>
              <group delimiter=", ">
                <text variable="publisher"/>
                <text variable="publisher-place"/>
                <text macro="ano"/>
              </group>
            </group>
          </group>
          <text macro="eletronico" prefix=". "/>
        </else-if>

        <!-- NORMA TÉCNICA, RELATÓRIO E DOCUMENTO INSTITUCIONAL -->
        <else-if type="standard report legislation regulation" match="any">
          <group delimiter=". ">
            <text macro="author"/>
            <text macro="title-destaque"/>
            <text macro="edicao"/>
            <text macro="imprenta"/>
            <text variable="number-of-pages" suffix=" p."/>
          </group>
          <text macro="eletronico" prefix=". "/>
        </else-if>

        <!-- DOCUMENTO EM MEIO ELETRÔNICO (7.20) -->
        <else-if type="webpage post-weblog post dataset software" match="any">
          <group delimiter=". ">
            <text macro="author"/>
            <text macro="title-destaque"/>
            <text macro="container"/>
            <text variable="publisher-place"/>
            <text macro="data-periodico"/>
          </group>
          <text macro="eletronico" prefix=". "/>
        </else-if>

        <!-- MONOGRAFIA NO TODO: LIVRO E DEMAIS (7.1 / 7.2) -->
        <else>
          <group delimiter=". ">
            <text macro="author"/>
            <text macro="title-destaque"/>
            <text macro="editor-secundario"/>
            <text macro="edicao"/>
            <text macro="imprenta"/>
            <text variable="number-of-pages" suffix=" p."/>
          </group>
          <text macro="eletronico" prefix=". "/>
        </else>

      </choose>
    </layout>
  </bibliography>
</style>
