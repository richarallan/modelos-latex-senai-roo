{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/richarallan/modelos-latex-senai-roo/schemas/documento.schema.json",
  "title": "Documento canônico do projeto Modelos LaTeX SENAI Rondonópolis",
  "description": "Contrato de metadados compartilhado pelos perfis documentais; apresentação e conteúdo são independentes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "versao_schema",
    "tipo_documento",
    "titulo",
    "autor",
    "instituicao",
    "unidade_operacional",
    "unidade_curricular",
    "publico",
    "carga_horaria"
  ],
  "properties": {
    "versao_schema": {
      "const": 1,
      "description": "Versão do contrato documental."
    },
    "tipo_documento": {
      "type": "string",
      "enum": [
        "atividade_avaliativa",
        "nota_aula"
      ]
    },
    "modelo": {
      "type": "string",
      "enum": [
        "artigo",
        "relatorio",
        "nota_aula",
        "atividade_avaliativa"
      ],
      "description": "Perfil documental. Quando ausente, usa o tipo_documento como perfil; artigo e relatório estão disponíveis para os dois tipos existentes."
    },
    "pre_textuais": {
      "type": "boolean",
      "default": true,
      "description": "Habilita os pré-textuais previstos no perfil. Elementos sem dados continuam omitidos."
    },
    "tipo_trabalho": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Identificação superior da capa do relatório; padrão RELATÓRIO TÉCNICO. Informe TRABALHO DE CONCLUSÃO DE CURSO apenas quando aplicável."
    },
    "natureza": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Finalidade do relatório, informada na folha de rosto, sem atribuir grau ou aprovação automaticamente."
    },
    "resumo": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "email": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
    },
    "curso": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "habilitacao": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "local": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "orientador": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "coordenacao": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "banca": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "data_aprovacao": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "titulo": {
      "type": "string",
      "minLength": 3,
      "pattern": "\\S"
    },
    "subtitulo": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "autor": {
      "description": "Nome de autoria ou lista de nomes na ordem de apresentação.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 3,
          "pattern": "\\S"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 3,
            "pattern": "\\S"
          }
        }
      ]
    },
    "instituicao": {
      "type": "string",
      "minLength": 2,
      "pattern": "\\S"
    },
    "unidade_operacional": {
      "type": "string",
      "minLength": 2,
      "pattern": "\\S"
    },
    "unidade_curricular": {
      "type": "string",
      "minLength": 2,
      "pattern": "\\S"
    },
    "publico": {
      "type": "string",
      "minLength": 2,
      "pattern": "\\S"
    },
    "carga_horaria": {
      "type": "string",
      "pattern": "^[0-9]+([,.][0-9]+)?\\s*(h|min)$"
    },
    "data": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "idioma": {
      "type": "string",
      "default": "pt-BR",
      "minLength": 1,
      "pattern": "\\S",
      "enum": [
        "pt-BR",
        "en",
        "es"
      ],
      "description": "Idioma principal suportado pelo núcleo: português brasileiro, inglês ou espanhol."
    },
    "palavras_chave": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "bibliografia": {
      "description": "Arquivo(s) CSL-YAML ou CSL-JSON, relativos ao Markdown; cada referência tem id estável.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        }
      ]
    },
    "capa": {
      "type": "boolean",
      "description": "Exibe a capa quando os pré-textuais estiverem habilitados."
    },
    "folha_rosto": {
      "type": "boolean",
      "description": "Exibe a folha de rosto quando os pré-textuais estiverem habilitados."
    },
    "aprovacao": {
      "type": "boolean",
      "description": "Permite a página de aprovação somente se houver coordenação, banca ou data de aprovação; true não cria uma página vazia."
    },
    "sumario": {
      "type": "boolean",
      "description": "Substitui a preferência de sumário do perfil. Sem títulos no conteúdo, o sumário é omitido mesmo quando true."
    }
  }
}
